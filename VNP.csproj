<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <!-- RECORDING: the hooks the run review's recordings read on weapons and units (CollectPlaced and a few
       read-only accessors). Defined only in the editor's Debug configuration, so exports leave them out. A
       special build that records fights would define it too, and keep scripts/cheats/playtesting/. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>$(DefineConstants);RECORDING</DefineConstants>
  </PropertyGroup>
  <!-- Arbiter, the decision library the pilots are built on (arbiter/README.md): its own project, so it can't use
       the game's code. Its folder is left out of the game's own compile. -->
  <ItemGroup>
    <Compile Remove="arbiter/**" />
    <ProjectReference Include="arbiter/Arbiter.csproj" />
  </ItemGroup>
  <!-- Playtest cheats: compiled only in the editor's Debug configuration, never in an export. -->
  <ItemGroup Condition=" '$(Configuration)' != 'Debug' ">
    <Compile Remove="scripts/cheats/**" />
  </ItemGroup>
</Project>
